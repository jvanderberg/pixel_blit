	(text "External override header for power supply. \nNote that 5V has a schottky, 3v3 does not.\nTo override 3v3 the 3v3 override jumper JP1 must be cut"
		(exclude_from_sim no)
		(at 220.472 36.576 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
