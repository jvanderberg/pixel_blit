			)
			(justify left bottom)
		)
		(uuid "3b32e3cf-7c1f-43ad-8f4f-e2ce9c5b5f15")
	)
	(text "Feedback resistors are biased for 5.3V, \nshould give circa 5V after the Schottky. \nVBus is protected against reverse bias \nso USB should never see this voltage if \nboth are plugged in."
		(exclude_from_sim no)
		(at 158.496 69.85 0)
		(effects
