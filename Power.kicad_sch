		(uuid "3b32e3cf-7c1f-43ad-8f4f-e2ce9c5b5f15")
	)
	(text "3.3V: TPS62A02A forced-PWM buck, 2.4 MHz, 1 uH / 22 uF. 0.6 V x (1 + 100k/22k) = 3.33 V.\nReplaces the 300 mA ME6217 LDO; C28 stays at the 3V3 node."
		(exclude_from_sim no)
		(at 30.48 160.02 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "476575be-926d-4153-b989-0beb484b9cff")
	)
	(text "Overrides"
		(exclude_from_sim no)
		(at 220.218 31.496 0)
		(effects
			(font
